{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=1 npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gev.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{config/**,src/data/local_data/cctv_ground_heights/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/gev" }]
}
